---
import Layout from "@/layouts/Layout.astro";
import FlowNav from "@/components/navigation/FlowNav.astro";
import DashboardActions from "@/components/dashboard/DashboardActions";
import DashboardDeckList from "@/components/dashboard/DashboardDeckList";
import { mockDecks } from "@/mocks/decks";
import DashboardAvatar from "@/components/dashboard/DashboardAvatar";
---

<Layout title="Decks - Pixel Flashcard">
  <main
    class="mx-auto flex min-h-screen w-full max-w-2xl flex-col gap-6 px-4 py-8"
  >
    <FlowNav backHref="/login" />

    <DashboardActions client:load />

    <DashboardDeckList decks={mockDecks} client:load />
  </main>
</Layout>
